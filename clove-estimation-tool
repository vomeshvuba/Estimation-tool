<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Estimation & Quotation System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --primary:#F97316;
  --primary-dark:#C2410C;
  --secondary:#FFF7ED;
  --success:#15803D;
  --warning:#F59E0B;
  --danger:#DC2626;
  --text:#171717;
  --muted:#737373;
  --border:#E5E5E5;
  --bg:#F8FAFC;
  --white:#fff;
  --shadow:0 4px 20px rgba(0,0,0,.05);
  --sidebar-width:264px;
  --radius-card:14px;
  --radius-control:9px;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.app{
  display:flex;
  min-height:100vh;
}

/* SIDEBAR */
.sidebar{
  width:250px;
  background:#1c332a;
  color:white;
  padding:20px 14px;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  overflow:auto;
}

.logo{
  padding:10px 12px 25px;
  border-bottom:1px solid rgba(255,255,255,.15);
  margin-bottom:18px;
}

.logo h1{
  font-size:20px;
  margin:0 0 5px;
}

.logo span{
  font-size:12px;
  color:#bdcfc2;
}

.nav-section{
  font-size:10px;
  text-transform:uppercase;
  color:#94ad9d;
  padding:15px 12px 7px;
  letter-spacing:1px;
}

.nav-btn{
  width:100%;
  background:transparent;
  border:0;
  color:#e0ebe3;
  text-align:left;
  padding:11px 12px;
  border-radius:7px;
  margin:2px 0;
}

.nav-btn:hover,
.nav-btn.active{
  background:#315442;
  color:white;
}

/* MAIN */
.main{
  margin-left:250px;
  width:calc(100% - 250px);
}

.topbar{
  height:68px;
  background:white;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 30px;
  position:sticky;
  top:0;
  z-index:10;
}

.topbar h2{
  margin:0;
  font-size:21px;
}

.user-badge{
  font-size:13px;
  color:var(--muted);
}

.content{
  padding:30px;
  max-width:1500px;
  margin:auto;
}

/* GENERAL */
.page{
  display:none;
}

.page.active{
  display:block;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:10px;
  box-shadow:var(--shadow);
  padding:22px;
  margin-bottom:20px;
}

.card h3{
  margin:0 0 17px;
  font-size:17px;
}

.grid{
  display:grid;
  gap:16px;
}

.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}

.field{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.field label{
  font-size:12px;
  font-weight:bold;
  color:var(--muted);
}

.field input,
.field select,
.field textarea{
  width:100%;
  border:1px solid var(--border);
  border-radius:6px;
  padding:10px 11px;
  background:white;
  color:var(--text);
}

.field textarea{
  min-height:90px;
  resize:vertical;
}

.field input:focus,
.field select:focus,
.field textarea:focus{
  outline:2px solid rgba(49,92,70,.16);
  border-color:var(--primary);
}

.btn{
  border:0;
  border-radius:6px;
  padding:10px 15px;
  font-weight:bold;
  font-size:13px;
}

.btn-primary{
  background:var(--primary);
  color:white;
}

.btn-primary:hover{
  background:var(--primary-dark);
}

.btn-secondary{
  background:#e8eee9;
  color:#34483b;
}

.btn-success{
  background:var(--success);
  color:white;
}

.btn-danger{
  background:var(--danger);
  color:white;
}

.btn-warning{
  background:var(--warning);
  color:white;
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.muted{
  color:var(--muted);
  font-size:13px;
}

/* DASHBOARD */
.stats{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:10px;
  padding:18px;
  box-shadow:var(--shadow);
}

.stat-label{
  font-size:12px;
  color:var(--muted);
  margin-bottom:7px;
}

.stat-value{
  font-size:25px;
  font-weight:bold;
  color:var(--primary);
}

.stat-small{
  font-size:11px;
  color:var(--muted);
  margin-top:5px;
}

.progress{
  height:9px;
  background:#e5ece6;
  border-radius:20px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  background:var(--primary);
}

/* TABLE */
.table-wrap{
  overflow:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:13px;
}

th{
  background:#edf3ee;
  text-align:left;
  padding:11px;
  border-bottom:1px solid var(--border);
  white-space:nowrap;
}

td{
  padding:11px;
  border-bottom:1px solid #e8eee9;
  vertical-align:top;
}

tr:hover td{
  background:#f5f8f5;
}

.badge{
  display:inline-block;
  padding:5px 8px;
  border-radius:20px;
  font-size:11px;
  font-weight:bold;
}

.badge-draft{background:#e9eeea;color:#4c5a50}
.badge-review{background:#f8edd9;color:#80551f}
.badge-approved{background:#dcece1;color:#28583e}
.badge-sent{background:#e0eeea;color:#315f52}
.badge-won{background:#dcece1;color:#28583e}
.badge-lost{background:#f6e3e0;color:#873f3c}
.badge-hold{background:#e8ebe8;color:#4b554e}

/* STEPS */
.steps{
  display:flex;
  gap:5px;
  margin-bottom:22px;
  overflow:auto;
}

.step{
  flex:1;
  min-width:130px;
  padding:11px;
  text-align:center;
  background:#e8eee9;
  color:#68776d;
  font-size:12px;
  font-weight:bold;
  border-radius:6px;
}

.step.active{
  background:var(--primary);
  color:white;
}

.step.completed{
  background:#dcece1;
  color:var(--primary);
}

/* CHECKBOXES */
.checkbox-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.check{
  display:flex;
  align-items:center;
  gap:8px;
  padding:9px;
  border:1px solid var(--border);
  border-radius:6px;
  font-size:13px;
}

.check input{
  accent-color:var(--primary);
}

/* ESTIMATE SUMMARY */
.summary-box{
  background:#f5f8f5;
  border:1px solid var(--border);
  border-radius:8px;
  padding:15px;
}

.summary-row{
  display:flex;
  justify-content:space-between;
  padding:8px 0;
  border-bottom:1px solid #e3ebe4;
  font-size:13px;
}

.summary-row:last-child{
  border-bottom:0;
}

.summary-total{
  font-size:20px;
  font-weight:bold;
  color:var(--primary);
}

/* ALERT */
.alert{
  padding:12px 14px;
  border-radius:7px;
  margin-bottom:15px;
  font-size:13px;
}

.alert-info{
  background:#e4efe7;
  color:#315d43;
}

.alert-warning{
  background:#f8edd9;
  color:#80551f;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-content{
  background:white;
  width:min(900px,100%);
  max-height:90vh;
  overflow:auto;
  border-radius:10px;
  padding:25px;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close{
  border:0;
  background:none;
  font-size:25px;
}

/* REPORT */
.report-preview{
  background:white;
  max-width:900px;
  margin:auto;
  padding:45px;
  border:1px solid var(--border);
}

.report-header{
  border-bottom:3px solid var(--primary);
  padding-bottom:18px;
  margin-bottom:25px;
}

.report-header h1{
  color:var(--primary);
  margin:0;
}

.report-table{
  margin:20px 0;
}

.report-total{
  font-size:20px;
  font-weight:bold;
  color:var(--primary);
  text-align:right;
  padding-top:15px;
}

.quote-section{
  margin:25px 0;
}

.quote-section h3{
  color:var(--primary);
  border-bottom:1px solid var(--border);
  padding-bottom:7px;
}

/* MOBILE */
@media(max-width:1000px){
  .sidebar{
    width:210px;
  }

  .main{
    margin-left:210px;
    width:calc(100% - 210px);
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .grid-4{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:750px){
  .sidebar{
    position:static;
    width:100%;
    min-height:auto;
  }

  .app{
    display:block;
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .topbar{
    position:static;
  }

  .content{
    padding:15px;
  }

  .grid-2,
  .grid-3,
  .grid-4,
  .checkbox-grid{
    grid-template-columns:1fr;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .sidebar{
    display:none;
  }
}

/* PRINT */
@media print{
  body{
    background:white;
  }

  .sidebar,
  .topbar,
  .no-print{
    display:none !important;
  }

  .main{
    margin:0;
    width:100%;
  }

  .content{
    padding:0;
  }

  .page{
    display:none !important;
  }

  #quotePrintPage,
  #internalPrintPage{
    display:block !important;
  }

  .report-preview{
    border:0;
    padding:0;
    max-width:none;
  }
}
</style>
<style>
