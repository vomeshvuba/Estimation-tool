/* =========================================================
   DASHBOARD
========================================================= */

function renderDashboard(){

  const total=estimates.length;

  const pending=
    estimates.filter(e=>
      ["Draft","Under Review","On Hold"].includes(e.status)
    ).length;

  const won=
    estimates.filter(e=>e.status==="Won").length;

  const lost=
    estimates.filter(e=>e.status==="Lost").length;

  const completed=won+lost;

  const winRate=
    completed
      ? (won/completed)*100
      : 0;

  const quoted=
    estimates.reduce((sum,e)=>
      sum+Number(e.finalPrice||0),0);

  const hours=
    estimates.reduce((sum,e)=>
      sum+Number(e.totalHours||0),0);

  const average=
    total ? quoted/total : 0;

  const averageHours=
    total ? hours/total : 0;


  document.getElementById("statTotal").textContent=total;
  document.getElementById("statPending").textContent=pending;
  document.getElementById("statWon").textContent=won;
  document.getElementById("statLost").textContent=lost;
  document.getElementById("statWinRate").textContent=
    winRate.toFixed(1)+"%";

  document.getElementById("dashboardQuoted").textContent=
    formatAllCurrencies(quoted);

  document.getElementById("dashboardHours").textContent=
    formatNumber(hours);

  document.getElementById("dashboardAverage").textContent=
    formatAllCurrencies(average);

  document.getElementById("dashboardAverageHours").textContent=
    formatNumber(averageHours);


  const denominator=Math.max(total,1);

  document.getElementById("progressDraft").style.width=
    (estimates.filter(e=>e.status==="Draft").length/denominator*100)+"%";

  document.getElementById("progressReview").style.width=
    (estimates.filter(e=>e.status==="Under Review").length/denominator*100)+"%";

  document.getElementById("progressApproved").style.width=
    (estimates.filter(e=>
      ["Approved","Sent"].includes(e.status)
    ).length/denominator*100)+"%";

  document.getElementById("progressWon").style.width=
    (won/denominator*100)+"%";


  const tbody=document.getElementById("dashboardTable");

  tbody.innerHTML="";


  estimates.slice(0,8).forEach(e=>{

    const tr=document.createElement("tr");

    tr.innerHTML=`

      <td>${escapeHtml(e.estimateNumber)}</td>

      <td>${escapeHtml(e.projectName)}</td>

      <td>${escapeHtml(e.clientCompany)}</td>

      <td>${escapeHtml((e.services||[]).join(", ") || "-")}</td>

      <td>${formatNumber(e.totalHours)}</td>

      <td>${money(e.finalPrice,e.currency)}</td>

      <td>
        <span class="badge ${statusClass(e.status)}">
          ${escapeHtml(e.status)}
        </span>
      </td>

    `;

    tbody.appendChild(tr);

  });


  if(estimates.length===0){

    tbody.innerHTML=`
      <tr>
        <td colspan="7" style="text-align:center;padding:30px">
          No estimates yet. Click "New Estimate" to create your first project.
        </td>
      </tr>
    `;

  }

}


