/* =========================================================
   DATA EXPORT
========================================================= */

function exportData(){

  const data={
    estimates,
    rates,
    settings,
    exportedAt:new Date().toISOString()
  };

  const blob=
    new Blob(
      [JSON.stringify(data,null,2)],
      {type:"application/json"}
    );

  const url=
    URL.createObjectURL(blob);

  const a=document.createElement("a");

  a.href=url;
  a.download=
    `estimation-hub-backup-${new Date().toISOString().slice(0,10)}.json`;

  a.click();

  URL.revokeObjectURL(url);

}


/* =========================================================
   DATA IMPORT
========================================================= */

function importData(event){

  const file=event.target.files[0];

  if(!file){
    return;
  }

  const reader=new FileReader();

  reader.onload=function(){

    try{

      const data=JSON.parse(reader.result);

      if(Array.isArray(data.estimates)){
        estimates=data.estimates;
      }

      if(data.rates){
        rates=data.rates;
      }

      if(data.settings){
        settings=data.settings;
      }

      localStorage.setItem(
        STORAGE_ESTIMATES,
        JSON.stringify(estimates)
      );

      localStorage.setItem(
        STORAGE_RATES,
        JSON.stringify(rates)
      );

      localStorage.setItem(
        STORAGE_SETTINGS,
        JSON.stringify(settings)
      );

      alert("Backup imported successfully.");

      renderDashboard();

    }
    catch(error){

      alert("Invalid backup file.");

    }

  };

  reader.readAsText(file);

}


/* =========================================================
   DELETE ALL
========================================================= */

function clearAllData(){

  const confirmation=
    prompt(
      'Type DELETE to remove all local estimates and settings.'
    );

  if(confirmation!=="DELETE"){
    return;
  }

  localStorage.removeItem(STORAGE_ESTIMATES);
  localStorage.removeItem(STORAGE_RATES);
  localStorage.removeItem(STORAGE_SETTINGS);

  location.reload();

}


/* =========================================================
   HELPERS
========================================================= */

function formatNumber(value){

  return Number(value||0).toLocaleString(
    undefined,
    {
      maximumFractionDigits:1
    }
  );

}


function money(value,currency){

  return Number(value||0).toLocaleString(
    undefined,
    {
      style:"currency",
      currency:currency || "EUR",
      maximumFractionDigits:2
    }
  );

}


function formatAllCurrencies(value){

  return Number(value||0).toLocaleString(
    undefined,
    {
      maximumFractionDigits:0
    }
  );

}


function statusClass(status){

  const map={
    "Draft":"badge-draft",
    "Under Review":"badge-review",
    "Approved":"badge-approved",
    "Sent":"badge-sent",
    "Won":"badge-won",
    "Lost":"badge-lost",
    "On Hold":"badge-hold",
    "Cancelled":"badge-lost"
  };

  return map[status] || "badge-draft";

}


function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* =========================================================
   INITIALISE
========================================================= */

document.addEventListener("DOMContentLoaded",()=>{
  const menuToggle=document.getElementById("menuToggle");
  const sidebarBackdrop=document.getElementById("sidebarBackdrop");

  const setSidebarOpen=open=>{
    document.body.classList.toggle("sidebar-open",open);
    menuToggle.setAttribute("aria-expanded",String(open));
    menuToggle.setAttribute("aria-label",open ? "Close navigation" : "Open navigation");
  };

  menuToggle.addEventListener("click",()=>{
    setSidebarOpen(menuToggle.getAttribute("aria-expanded")!=="true");
  });

  sidebarBackdrop.addEventListener("click",()=>{
    setSidebarOpen(false);
    menuToggle.focus();
  });

  document.querySelectorAll(".nav-btn").forEach(button=>{
    button.addEventListener("click",()=>{
      if(document.body.classList.contains("sidebar-open")){
        setSidebarOpen(false);
        menuToggle.focus();
      }
    });
  });

  document.addEventListener("keydown",event=>{
    if(event.key==="Escape" && document.body.classList.contains("sidebar-open")){
      setSidebarOpen(false);
      menuToggle.focus();
    }
  });

  renderDashboard();

  loadRateInputs();

  loadSettings();

});

</script>

