      document.getElementById("adjustmentReason").value,

    createdAt:
      existingId
        ? currentEstimate.createdAt
        : new Date().toISOString(),

    updatedAt:
      new Date().toISOString()

  };


  const existingIndex=
    estimates.findIndex(x=>x.id===data.id);

  if(existingIndex>=0){

    estimates[existingIndex]=data;

  }
  else{

    estimates.unshift(data);

  }


  localStorage.setItem(
    STORAGE_ESTIMATES,
    JSON.stringify(estimates)
  );


  currentEstimate.editingId=data.id;
  currentEstimate.estimateNumber=data.estimateNumber;
  currentEstimate.quoteNumber=data.quoteNumber;
  currentEstimate.quoteVersion=data.quoteVersion;
  currentEstimate.createdAt=data.createdAt;


  alert("Estimate saved successfully.");

  renderDashboard();

}


