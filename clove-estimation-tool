/* =========================================================
   REPORTS
========================================================= */

function renderReports(){

  const won=
    estimates.filter(e=>e.status==="Won").length;

  const lost=
    estimates.filter(e=>e.status==="Lost").length;

  const completed=won+lost;

  const winRate=
    completed ? won/completed*100 : 0;

  const quoted=
    estimates.reduce((s,e)=>
      s+Number(e.finalPrice||0),0);

  const hours=
    estimates.reduce((s,e)=>
      s+Number(e.totalHours||0),0);

  const average=
    estimates.length ? quoted/estimates.length : 0;


  document.getElementById("reportWon").textContent=won;
  document.getElementById("reportLost").textContent=lost;
  document.getElementById("reportWinRate").textContent=
    winRate.toFixed(1)+"%";

  document.getElementById("reportQuoted").textContent=
    formatAllCurrencies(quoted);

  document.getElementById("reportAverage").textContent=
    formatAllCurrencies(average);

  document.getElementById("reportHours").textContent=
    formatNumber(hours);


  const reasons={};

  estimates
    .filter(e=>e.status==="Lost")
    .forEach(e=>{

      const reason=e.lostReason || "Not specified";

      reasons[reason]=(reasons[reason]||0)+1;

    });


  const container=document.getElementById("lossReasons");

  container.innerHTML="";


  Object.entries(reasons)
    .sort((a,b)=>b[1]-a[1])
    .forEach(([reason,count])=>{

      const row=document.createElement("div");

      row.className="summary-row";

      row.innerHTML=`
        <span>${escapeHtml(reason)}</span>
        <strong>${count}</strong>
      `;

      container.appendChild(row);

    });


  if(Object.keys(reasons).length===0){

    container.innerHTML=
      `<div class="muted">No lost projects recorded yet.</div>`;

  }

}


