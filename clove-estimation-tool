/* =========================================================
   STEPS
========================================================= */

function nextStep(step){

  for(let i=1;i<=6;i++){

    const container=document.getElementById("estimateStep"+i);

    if(container){
      container.style.display=(i===step ? "block" : "none");
    }

    const stepEl=document.getElementById("step"+i);

    if(stepEl){

      stepEl.classList.remove("active","completed");

      if(i===step){
        stepEl.classList.add("active");
      }

      if(i<step){
        stepEl.classList.add("completed");
      }

    }

  }

  if(step===6){
    calculatePricing();
    renderFinalReview();
  }

}


/* =========================================================
   GET CHECKED VALUES
========================================================= */

function checkedValues(className){

  return [...document.querySelectorAll("."+className+":checked")]
    .map(x=>x.value);

}


/* =========================================================
   CALCULATION ENGINE
========================================================= */

function getRate(discipline,lod){

  const map={
    "Architecture":"arch",
    "Structure":"str",
    "Mechanical":"mech",
    "Electrical":"elec",
    "Plumbing":"plumb",
    "Fire Protection":"fire"
  };

  const prefix=map[discipline];

  if(!prefix){
    return 0;
  }

  return Number(rates[prefix+lod] || 0);

}


function getPointCloudFactor(){

  const value=document.getElementById("pointCloudQuality").value;

  const map={
    "Excellent":rates.pcExcellent,
    "Good":rates.pcGood,
    "Average":rates.pcAverage,
    "Poor":rates.pcPoor,
    "Very Poor":rates.pcVeryPoor
  };

  return Number(map[value] || 1);

}


function getComplexityFactor(){

  const value=document.getElementById("complexity").value;

  const map={
    "Low":rates.complexLow,
    "Medium":rates.complexMedium,
    "High":rates.complexHigh,
    "Very High":rates.complexVeryHigh
  };

  return Number(map[value] || 1);

}


function calculateEstimate(){

  const area=Number(document.getElementById("projectArea").value)||0;

  const floors=Number(document.getElementById("floors").value)||1;

  const buildings=Number(document.getElementById("buildings").value)||1;

  const lod=document.getElementById("lod").value;

  const disciplines=checkedValues("disciplineCheck");

  const pcFactor=getPointCloudFactor();

  const complexityFactor=getComplexityFactor();

  let breakdown=[];

  let modelHours=0;

  disciplines.forEach(discipline=>{

    let rate=getRate(discipline,lod);

    let systemHours=area*rate;

    /*
      Multiple buildings/floors increase complexity.
      This is deliberately simple for V1.
      Replace with your company's actual methodology later.
    */

    let floorFactor=1+(Math.max(floors-1,0)*0.04);

    let buildingFactor=1+(Math.max(buildings-1,0)*0.10);

    systemHours=
      systemHours*
      pcFactor*
      complexityFactor*
      floorFactor*
      buildingFactor;

    systemHours=Math.max(0,systemHours);

    breakdown.push({
      workPackage:discipline,
      basis:`${area.toLocaleString()} area × ${rate} hrs/unit`,
      systemHours:systemHours,
      adjustment:0,
      finalHours:systemHours
    });

    modelHours+=systemHours;

  });


  /*
    If no disciplines are selected,
    use a warning rather than silently generating a misleading estimate.
  */

  const manualAdjustment=
    Number(document.getElementById("manualAdjustment").value)||0;

  const adjustmentReason=
    document.getElementById("adjustmentReason").value.trim();

  if(manualAdjustment!==0){

    breakdown.push({
      workPackage:"Estimator Adjustment",
      basis:adjustmentReason || "Manual adjustment",
      systemHours:0,
      adjustment:manualAdjustment,
      finalHours:manualAdjustment
    });

  }


  const qaHours=modelHours*(Number(rates.qa)||0)/100;

  const pmHours=modelHours*(Number(rates.pm)||0)/100;

  const totalHours=
    modelHours+
    qaHours+
    pmHours+
    manualAdjustment;


  currentEstimate.breakdown=breakdown;
  currentEstimate.modelHours=modelHours;
  currentEstimate.qaHours=qaHours;
  currentEstimate.pmHours=pmHours;
  currentEstimate.totalHours=Math.max(0,totalHours);


  renderBreakdown();

  document.getElementById("totalModelHours").textContent=
    formatNumber(modelHours);

  document.getElementById("totalQAHours").textContent=
    formatNumber(qaHours);

  document.getElementById("totalPMHours").textContent=
    formatNumber(pmHours);

  calculatePricing();

}


/* =========================================================
   BREAKDOWN DISPLAY
========================================================= */

function renderBreakdown(){

  const tbody=document.getElementById("estimateBreakdown");

  tbody.innerHTML="";

  currentEstimate.breakdown.forEach(item=>{

    const tr=document.createElement("tr");

    tr.innerHTML=`
      <td><strong>${escapeHtml(item.workPackage)}</strong></td>
      <td>${escapeHtml(item.basis)}</td>
      <td>${formatNumber(item.systemHours)}</td>
      <td>${formatNumber(item.adjustment)}</td>
      <td><strong>${formatNumber(item.finalHours)}</strong></td>
    `;

    tbody.appendChild(tr);

  });

}


/* =========================================================
   PRICING
========================================================= */

function calculatePricing(){

  if(!currentEstimate.totalHours){
    calculateEstimate();
  }

  const totalHours=currentEstimate.totalHours;

  const labourRate=
    Number(document.getElementById("labourRate").value)||0;

  const contingencyPercent=
    Number(document.getElementById("contingencyPercent").value)||0;

  const otherCosts=
    Number(document.getElementById("otherCosts").value)||0;

  const markupPercent=
    Number(document.getElementById("markupPercent").value)||0;

  const labourCost=totalHours*labourRate;

  const contingency=
    (labourCost+otherCosts)*contingencyPercent/100;

  const costBasis=
    labourCost+
    contingency+
    otherCosts;

  const markup=
    costBasis*markupPercent/100;

  const finalPrice=
    costBasis+
    markup;

  currentEstimate.internalLabourCost=labourCost;
  currentEstimate.contingency=contingency;
  currentEstimate.otherCosts=otherCosts;
  currentEstimate.costBasis=costBasis;
  currentEstimate.markup=markup;
  currentEstimate.finalPrice=finalPrice;


  const currency=
    document.getElementById("currency").value;

  document.getElementById("priceHours").textContent=
    formatNumber(totalHours);

  document.getElementById("priceLabour").textContent=
    money(labourCost,currency);

  document.getElementById("priceContingency").textContent=
    money(contingency,currency);

  document.getElementById("priceOther").textContent=
    money(otherCosts,currency);

  document.getElementById("priceCostBasis").textContent=
    money(costBasis,currency);

  document.getElementById("priceMarkup").textContent=
    money(markup,currency);

  document.getElementById("finalPrice").textContent=
    money(finalPrice,currency);

}


